# Database Configuration
DB_HOST=db
DB_PORT=1433
DB_NAME=FoodProject
DB_USER=sa
DB_PASSWORD=your_strong_password_here

# SQL Server Configuration
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-latest
DB_CONTAINER_NAME=mssql_db
DB_VOLUME_NAME=mssql_data

# Tomcat Configuration
TOMCAT_PORT=8080
WEB_CONTAINER_NAME=java_tomcat_app

# JVM Options for Tomcat
JAVA_OPTS=-Xms512m -Xmx1024m

# Maven Build Options
MAVEN_OPTS=-DskipTests